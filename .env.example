# CNS shares the HUB Supabase project — same URL, same keys, same auth.users.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed for question-bank grading (reads answer keys, which RLS hides from
# ordinary users via column-level grants) and for library entitlement reads.
SUPABASE_SERVICE_ROLE_KEY=

# THE linchpin of single sign-on. Must be IDENTICAL to HUB's value.
# Leave BLANK locally: browsers reject a domain attribute for bare "localhost",
# and localhost:3000 vs localhost:3001 share cookies regardless of ports, which
# makes local SSO testing a false pass. To exercise it properly use
# app.localtest.me:3000 / cns.localtest.me:3001 with .localtest.me here.
NEXT_PUBLIC_COOKIE_DOMAIN=

# How middleware migrates a browser still holding cookies from the previous
# cookie-domain version. Must match HUB's setting during a migration window.
#   silent  — (default, leave unset) swap the cookies atomically; invisible.
#   relogin — clear the session and send the user to HUB's /welcome.
COOKIE_MIGRATION_MODE=

# Where CNS sends unauthenticated visitors, and where it links back to.
NEXT_PUBLIC_HUB_URL=https://unn.nerusalem.com
NEXT_PUBLIC_SITE_URL=https://cns.nerusalem.com

# Pre-SSO escape hatch: "1" disables the auth gate so the domain can serve a
# page before the cookie domain is live on HUB. Unset it to turn CNS on.
CNS_PUBLIC_PREVIEW=

# Media for question images and lesson assets. Scope this token to the cns/
# key prefix. NOTE: R2_DIGITAL_BUCKET is deliberately NOT here — the paid-goods
# bucket stays HUB-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Transactional email. UNSET = in-app notifications only, exactly as before —
# setting this key is the single switch that turns CNS sending on, so it can be
# deployed dark. Covers: application status changes (shortlisted, interview,
# selected, not selected), new-applicant alerts to employers, and the daily job
# alert digest. Not marketing; there is no bulk send path.
RESEND_API_KEY=
CNS_EMAIL_FROM=UNN <notifications@nerusalem.com>

# Salt for the one-way viewer key behind job view counts. Any long random
# string; changing it resets per-viewer dedupe (counts already recorded stay).
# Without it the hash falls back to the Supabase URL, which is stable but
# guessable — set it in production.
JOB_VIEW_SALT=

# UNN Learn — lecture video (PRIVATE bucket, presigned browser PUT).
# Falls back to R2_DOCS_BUCKET when unset, so a single private bucket also works.
# The bucket MUST allow PUT from this app's origin in its CORS policy, or the
# browser blocks the upload before it leaves and the failure is invisible
# server-side. Course COVERS use the public R2_BUCKET/R2_PUBLIC_URL above.
R2_VIDEO_BUCKET=
