# CNS shares the HUB Supabase project — same URL, same keys, same auth.users.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Needed for question-bank grading (reads answer keys, which RLS hides from
# ordinary users via column-level grants) and for library entitlement reads.
SUPABASE_SERVICE_ROLE_KEY=

# THE linchpin of single sign-on. Must be IDENTICAL to HUB's value.
# Leave BLANK locally: browsers reject a domain attribute for bare "localhost",
# and localhost:3000 vs localhost:3001 share cookies regardless of ports, which
# makes local SSO testing a false pass. To exercise it properly use
# app.localtest.me:3000 / cns.localtest.me:3001 with .localtest.me here.
NEXT_PUBLIC_COOKIE_DOMAIN=

# Where CNS sends unauthenticated visitors, and where it links back to.
NEXT_PUBLIC_HUB_URL=https://app.unnhub.org
NEXT_PUBLIC_SITE_URL=https://cns.unnhub.org

# Pre-SSO escape hatch: "1" disables the auth gate so the domain can serve a
# page before the cookie domain is live on HUB. Unset it to turn CNS on.
CNS_PUBLIC_PREVIEW=

# Media for question images and lesson assets. Scope this token to the cns/
# key prefix. NOTE: R2_DIGITAL_BUCKET is deliberately NOT here — the paid-goods
# bucket stays HUB-only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
